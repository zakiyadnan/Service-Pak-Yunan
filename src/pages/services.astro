---

<Layout title="Layanan Kami - Service Pak Yunan">
  <main class="pt-24 pb-20"> <!-- PT to account for fixed navbar -->
    <div class="container mx-auto px-4">
      <div class="text-center mb-16">
        <h1 class="text-4xl lg:text-5xl font-bold text-dark mb-6">Layanan Profesional Kami</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Daftar lengkap layanan <span class="font-semibold text-primary">service AC terdekat</span> dan elektronik di <span class="font-semibold text-primary">Tambun Selatan, Bekasi</span>. Kami menjangkau area Mangun Jaya, Sumber Jaya, hingga Jejalen Jaya.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {services.map(service => (
          <ServiceCard {...service} />
        ))}
      </div>

      <!-- TESTIMONIALS SECTION -->
      <section class="mt-32">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-dark mb-4">Testimoni Pelanggan</h2>
          <div class="flex justify-center gap-1 text-yellow-400 mb-2">
            {[...Array(5)].map(() => <i class="fa-solid fa-star"></i>)}
          </div>
          <p class="text-gray-600">Apa kata mereka tentang layanan Pak Yunan?</p>
        </div>

        <div class="relative group pb-10">
          <!-- Slider Container with Viewport -->
          <div class="overflow-hidden">
            <div id="testimonial-slider" class="flex transition-transform duration-700 ease-in-out">
              {testimonials.map((t) => (
                <div class="min-w-full md:min-w-[50%] lg:min-w-[33.333%] px-3">
                  <div class="bg-white p-8 rounded-2xl shadow-lg h-full flex flex-col transition-all duration-300 ease-out cursor-pointer hover:shadow-2xl md:hover:-translate-y-1.5 md:hover:scale-[1.02] active:-translate-y-1 active:scale-95 focus-visible:ring-2 focus-visible:ring-primary outline-none">
                    <div class="flex text-yellow-400 mb-4 gap-1">
                      {[...Array(5)].map(() => <i class="fa-solid fa-star text-sm"></i>)}
                    </div>
                    <p class="text-gray-600 italic mb-6 flex-grow leading-relaxed">
                      "{t.content}"
                    </p>
                    <div class="pt-6 border-t border-gray-50 mt-auto">
                      <p class="font-bold text-dark">{t.name}</p>
                      <p class="text-primary text-sm font-medium">{t.service}</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          
          <!-- Navigation Arrows -->
          <button id="prev-btn" class="absolute left-2 md:left-0 top-1/2 -translate-y-1/2 md:-translate-x-4 w-10 h-10 md:w-12 md:h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg flex items-center justify-center text-dark hover:bg-primary hover:text-white transition-all z-20 md:opacity-0 md:group-hover:opacity-100 md:group-hover:translate-x-0">
            <i class="fa-solid fa-chevron-left text-lg md:text-xl"></i>
          </button>
          <button id="next-btn" class="absolute right-2 md:right-0 top-1/2 -translate-y-1/2 md:translate-x-4 w-10 h-10 md:w-12 md:h-12 bg-white/90 backdrop-blur-sm rounded-full shadow-lg flex items-center justify-center text-dark hover:bg-primary hover:text-white transition-all z-20 md:opacity-0 md:group-hover:opacity-100 md:group-hover:translate-x-0">
            <i class="fa-solid fa-chevron-right text-lg md:text-xl"></i>
          </button>
          
          <!-- Slider Navigation Dots -->
          <div class="flex justify-center gap-2 mt-8">
            {testimonials.map((_, i) => (
              <div class={`testimonial-dot w-2 h-2 rounded-full bg-gray-300 transition-colors cursor-pointer ${i === 0 ? 'bg-primary' : ''}`} data-index={i}></div>
            ))}
          </div>
        </div>
      </section>

      <div class="mt-20 bg-blue-50 rounded-3xl p-8 lg:p-12 text-center">
        <h2 class="text-3xl font-bold text-dark mb-4">Butuh Layanan Lain?</h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">
          Jika masalah elektronik Anda tidak tercantum di atas, jangan ragu untuk menanyakannya kepada kami via WhatsApp.
        </p>
        <a href="https://wa.me/6285881580217" target="_blank" class="bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-8 rounded-xl transition shadow-lg inline-flex items-center gap-2">
            <i class="fa-brands fa-whatsapp text-2xl"></i> Konsultasi Gratis
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  let currentIndex = 0;
  const slider = document.getElementById('testimonial-slider');
  const dots = document.querySelectorAll('.testimonial-dot');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const testimonialsCount = dots.length;
  let interval;

  function getVisibleCards() {
    if (window.innerWidth >= 1024) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  }

  function updateSlider() {
    if (!slider) return;
    
    const visibleCards = getVisibleCards();
    const maxIndex = testimonialsCount - visibleCards;
    
    if (currentIndex > maxIndex) currentIndex = 0;
    if (currentIndex < 0) currentIndex = maxIndex;

    const offset = currentIndex * (100 / visibleCards);
    slider.style.transform = `translateX(-${offset}%)`;

    // Update dots
    dots.forEach((dot, i) => {
      const isActive = i === currentIndex || 
                       (visibleCards >= 2 && i === currentIndex + 1) ||
                       (visibleCards === 3 && i === currentIndex + 2);
      
      if (i === currentIndex) {
        dot.classList.add('bg-primary');
        dot.classList.remove('bg-gray-300');
      } else {
        dot.classList.remove('bg-primary');
        dot.classList.add('bg-gray-300');
      }
    });
  }

  function startAutoPlay() {
    stopAutoPlay();
    interval = setInterval(() => {
      const visibleCards = getVisibleCards();
      const maxIndex = testimonialsCount - visibleCards;
      currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
      updateSlider();
    }, 4000); // Calmer timing for professional feel
  }

  function stopAutoPlay() {
    if (interval) clearInterval(interval);
  }

  function handleManualNav(direction) {
    stopAutoPlay();
    const visibleCards = getVisibleCards();
    const maxIndex = testimonialsCount - visibleCards;
    
    if (direction === 'next') {
      currentIndex = currentIndex >= maxIndex ? 0 : currentIndex + 1;
    } else {
      currentIndex = currentIndex <= 0 ? maxIndex : currentIndex - 1;
    }
    
    updateSlider();
    startAutoPlay(); // Restart timer
  }

  // Event Listeners
  if (slider) {
    // Only pause on hover for devices that support it (prevents stuck mobile swiper)
    const isHoverable = window.matchMedia('(hover: hover)').matches;
    if (isHoverable) {
      slider.parentElement.parentElement.addEventListener('mouseenter', stopAutoPlay);
      slider.parentElement.parentElement.addEventListener('mouseleave', startAutoPlay);
    }

    if (prevBtn) prevBtn.addEventListener('click', () => handleManualNav('prev'));
    if (nextBtn) nextBtn.addEventListener('click', () => handleManualNav('next'));

    dots.forEach(dot => {
      dot.addEventListener('click', () => {
        currentIndex = parseInt(dot.getAttribute('data-index'));
        handleManualNav('none');
      });
    });
    
    window.addEventListener('resize', updateSlider);
    
    // Initial start
    startAutoPlay();
    updateSlider();
  }
</script>
