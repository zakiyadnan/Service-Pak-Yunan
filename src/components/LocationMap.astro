---
const address = "Puri Cendana G6/31, RT 02/13, Sumber Jaya, Tambun Selatan, Bekasi";
const mapUrl = "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(address);
---

<section class="py-12 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-dark mb-4">Lokasi & Area Layanan</h2>
        <p class="text-gray-600">Kunjungi workshop kami atau hubungi kami untuk layanan di rumah Anda.</p>
      </div>

      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="block group relative overflow-hidden rounded-3xl shadow-lg border border-gray-100 hover:shadow-xl transition-all duration-300">
        <!-- Background Pattern / Map Placeholder -->
        <div class="h-64 bg-blue-50 w-full relative">
            <div class="absolute inset-0 opacity-10 bg-[url('https://upload.wikimedia.org/wikipedia/commons/thumb/b/bd/Google_Maps_Logo_2020.svg/512px-Google_Maps_Logo_2020.svg.png')] bg-center bg-no-repeat bg-contain"></div>
             <!-- Overlay Gradient -->
            <div class="absolute inset-0 bg-gradient-to-r from-white/80 to-transparent"></div>
            
            <div class="absolute inset-0 flex items-center justify-start p-8 md:p-12">
                <div class="relative z-10 max-w-lg">
                    <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full shadow-sm text-primary font-semibold mb-4 text-sm">
                        <i class="fa-solid fa-map-pin"></i> Workshop Kami
                    </div>
                    <h3 class="text-2xl font-bold text-dark mb-2">Lokasi Service Pak Yunan</h3>
                    <p class="text-gray-700 text-lg mb-6 leading-relaxed">
                        {address}
                    </p>
                    <span class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-xl font-semibold group-hover:bg-secondary transition-colors">
                        <i class="fa-solid fa-map-location-dot"></i> Buka di Google Maps
                    </span>
                </div>
            </div>
             <!-- Floating Icon Decorative -->
             <div class="absolute right-8 top-1/2 -translate-y-1/2 hidden md:block">
                <div class="w-24 h-24 bg-white rounded-full shadow-md flex items-center justify-center text-secondary text-4xl group-hover:scale-110 transition-transform duration-300">
                    <i class="fa-solid fa-location-arrow"></i>
                </div>
             </div>
        </div>
      </a>
    </div>
  </div>
</section>
