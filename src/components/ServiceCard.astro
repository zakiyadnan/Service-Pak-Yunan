---
interface Props {
  title: string;
  description: string;
  icon: string;
  price?: string;
}

const { title, description, icon, price } = Astro.props;
---

<div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-100 hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 group cursor-default">
  <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-primary transition-colors duration-300">
    <i class={`fa-solid ${icon} text-3xl text-primary group-hover:text-white transition-colors duration-300`}></i>
  </div>
  <h3 class="text-2xl font-bold text-dark mb-3 group-hover:text-primary transition-colors">{title}</h3>
  <p class="text-gray-600 mb-6 leading-relaxed">
    {description}
  </p>
  {price && (
    <div class="pt-6 border-t border-gray-100 flex items-center justify-between">
      <span class="text-sm text-gray-500">Mulai dari</span>
      <span class="text-lg font-bold text-secondary">{price}</span>
    </div>
  )}
</div>
