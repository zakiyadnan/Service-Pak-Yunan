---
const links = [
  { name: "Home", href: "/" },
  { name: "Layanan", href: "/services" },
];
---

<nav class="bg-white shadow-md fixed w-full z-50 top-0">
  <div class="container mx-auto px-4 py-3 flex justify-between items-center">
    <a href="/" class="flex items-center">
      <img src="/images/navbar-ac.webp" alt="Service Pak Yunan" class="max-h-14 md:max-h-15 lg:max-h-19 w-auto object-contain" />
    </a>

    <!-- Desktop Menu -->
    <ul class="hidden md:flex space-x-6 items-center">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-600 hover:text-primary transition font-medium"
            >
              {link.name}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/order" class="bg-primary hover:bg-secondary text-white px-4 py-2 rounded-lg transition shadow-md">
          Pesan Layanan
        </a>
      </li>
    </ul>

    <!-- Mobile Button -->
    <button id="mobile-menu-btn" class="md:hidden text-gray-600 focus:outline-none">
      <i class="fa-solid fa-bars text-2xl"></i>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-t p-4 absolute w-full shadow-lg">
    <ul class="flex flex-col space-y-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block text-gray-600 hover:text-primary transition font-medium"
            >
              {link.name}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/order" class="block w-full text-center bg-primary hover:bg-secondary text-white px-4 py-2 rounded-lg transition shadow-md">
          Pesan Layanan
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
